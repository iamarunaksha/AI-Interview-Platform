# ============================================================
# Backend (apps/api) Environment Configuration
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=interviewai_dev
DATABASE_SSL=false
# Or use a connection URL (takes precedence over individual fields):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewai_dev

# Connection pool tuning
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=10000

# Schema synchronize (disable in production — migrations run automatically)
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

# Cache & Queues (Redis — optional in local dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
# IMPORTANT: Replace with cryptographically secure strings in production!
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-jwt-access-secret-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# AI Provider Configuration (gemini | mock)
REALTIME_PROVIDER=gemini
LLM_PROVIDER=gemini
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
EVALUATION_PROVIDER=gemini

# Provider API Keys
# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Deepgram Voice AI Key (Get at: https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# Optional: OpenAI API Key (Get at: https://platform.openai.com/api-keys)
# OPENAI_API_KEY=

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Logging (debug | log | warn | error)
LOG_LEVEL=debug
