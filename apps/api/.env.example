# ============================================================
# Backend (apps/api) Environment Configuration
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=interviewai_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewai_dev

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=dev-jwt-access-secret-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# AI Provider Configuration (gemini | mock)
REALTIME_PROVIDER=gemini
LLM_PROVIDER=gemini
STT_PROVIDER=gemini
TTS_PROVIDER=gemini
EVALUATION_PROVIDER=gemini

# Provider API Keys
# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Optional: Deepgram Voice API Key (Get at: https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# Optional: OpenAI API Key (Get at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# File Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
